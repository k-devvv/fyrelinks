# Optional real sponsor placements. Leave empty until a genuine placement exists.
FYRE_SPONSOR_TITLE=
FYRE_HOME_SPONSOR_URL=
FYRE_ARTICLE_SPONSOR_URL=

# Origin of the separate Cloudflare Pages project serving /ads/frame.html.
# Empty keeps display ads off entirely. It must not be this site's own origin.
NEXT_PUBLIC_AD_FRAME_ORIGIN=

# Affiliate tracking URLs from your partner programmes. These are read by the
# /go/<slug> Pages Function at request time, so set them in the Cloudflare Pages
# project, not at build time. Unset means the plain link is used and earns nothing.
# Slugs live in lib/redirects.ts.
FYRE_AFF_RUNPOD=
FYRE_AFF_VIDEO_HIGGSFIELD=
FYRE_AFF_VIDEO_RUNWAY=
FYRE_AFF_VIDEO_LUMA=
FYRE_AFF_VIDEO_PIKA=
FYRE_AFF_AMAZON_US=
FYRE_AFF_AMAZON_UK=
FYRE_AFF_AMAZON_CA=
FYRE_AFF_AMAZON_DE=
FYRE_AFF_MINIMAX=
FYRE_AFF_SEEDANCE=
FYRE_AFF_IDEOGRAM=
FYRE_AFF_KIMI=

# GA4 and GTM public IDs are site constants in components/Analytics.tsx.
