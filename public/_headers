/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Content-hashed by the build, so they can never go stale.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Artwork is replaced by filename, not in place.
/art/*
  Cache-Control: public, max-age=604800
/media/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800

# Rebuilt every two hours; a shorter TTL keeps headlines from sticking.
/
  Cache-Control: public, max-age=600

# Affiliate hops must never be indexed, whichever host serves them.
/go/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# The static feed is typed from its .xml extension, which gives application/xml and
# disagrees with the rel=alternate link. Where the Pages Function serves /feed.xml it
# sets this itself and this rule does not apply.
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
