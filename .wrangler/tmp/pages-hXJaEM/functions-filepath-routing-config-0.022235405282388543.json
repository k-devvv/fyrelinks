{
  "routes": [
    {
      "routePath": "/go/:slug",
      "mountPath": "/go",
      "method": "GET",
      "module": [
        "go/[slug].js:onRequestGet"
      ]
    },
    {
      "routePath": "/feed.xml",
      "mountPath": "/",
      "method": "GET",
      "module": [
        "feed.xml.js:onRequestGet"
      ]
    }
  ],
  "baseURL": "/"
}